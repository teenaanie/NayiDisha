  "risk_policy": {
    "id": "education_discovery_risks",
    "version": "1.0.0",
    "rules": [
      {
        "id": "guaranteed_approval",
        "description": "Promises approval or loan amount",
        "category": "selling",
        "severity": "high",
        "detector": "hybrid",
        "examples": [
          "Your loan will definitely be approved."
        ],
        "context_exclusions": [
          "Negated assertion",
          "Quoted claim attributed to another person",
          "Question without affirmative assertion",
          "Appropriate response to an explicit customer request"
        ],
        "consequence": "review",
        "dimension_ids": [
          "responsible"
