# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Postgres (development). Same engine as Supabase, so this is a straight swap.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/frontline

# Supabase — use the SESSION POOLER string when running migrations and the seed
# from your laptop, and the TRANSACTION POOLER string (port 6543) for Vercel.
# Project Settings -> Database -> Connection string. Replace [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# "seeded" is the zero-cost Pune distance matrix. Setting this to "google"
# requires a billed Google Cloud account and throws rather than silently
# starting to cost money.
TRAVEL_PROVIDER=seeded

DEMO_MODE=true

# ---------------------------------------------------------------------------
# Rubric scoring and voice interpretation (both optional)
# ---------------------------------------------------------------------------
# Without a key both fall back to deterministic rules: free, offline, and
# honest about it — every rubric score it produces is flagged for review.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# The free allowance is 20 generate calls PER DAY, PER MODEL, per project, so
# the default deliberately spends flash-lite's bucket and leaves flash alone.
# GEMINI_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Optional demo gate
# ---------------------------------------------------------------------------
# Set this on a public deployment and the whole site sits behind one HTTP Basic
# prompt. Leave it unset locally.
# DEMO_PASSWORD=choose-something

# ---------------------------------------------------------------------------
# Sales practice (AI roleplay) — all optional
# ---------------------------------------------------------------------------
# Sarvam AI powers the AI customer in 11 Indian languages, voice transcription
# (Saarika), read-aloud replies (Bulbul) and translation for the evaluator
# (Mayura). Without it the customer runs from scripted rules in English, Hindi
# and Marathi, and voice uses the browser. https://dashboard.sarvam.ai
# SARVAM_API_KEY=
# SARVAM_CHAT_MODEL=sarvam-m
# SARVAM_TTS_SPEAKER=abhilash
#
# The evaluator prefers Claude, then Gemini (GEMINI_API_KEY above), then Sarvam.
# Without any model it scores by rules and flags every result for review.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# WhatsApp self-registration
# ---------------------------------------------------------------------------
# Signs events into /api/whatsapp/webhook. Falls back to DEMO_SESSION_SECRET.
# WHATSAPP_WEBHOOK_SECRET=
# Meta's webhook verification token, for when a real number is connected.
# WHATSAPP_VERIFY_TOKEN=
# Resumes go to a private Supabase Storage bucket when both are set; otherwise
# they are kept in the database (fine for a demo). Service key: server only.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_RESUME_BUCKET=resumes

# ---------------------------------------------------------------------------
# Practice coach (AI roleplay platform, docs/roleplay) — all optional
# ---------------------------------------------------------------------------
# mock (default): deterministic, offline, free. openai_compatible: any
# /chat/completions endpoint. Never commit a real key.
# RP_PROVIDER=mock
# RP_LLM_BASE_URL=https://api.example.com/v1
# RP_LLM_API_KEY=
# RP_LLM_API_KEY_FROM=GEMINI_API_KEY   # or name the variable that already holds the key
# RP_LLM_REASONING_EFFORT=none        # reasoning models: stop thinking tokens truncating output
# RP_EVAL_TIMEOUT_MS=120000           # evaluator and coach timeout (customer replies use RP_PROVIDER_TIMEOUT_MS)
# RP_LLM_MODEL=
# RP_LLM_MODEL_EVALUATOR=          # optional separate evaluator/coach model
# RP_PROVIDER_TIMEOUT_MS=30000
# RP_BREAKER_THRESHOLD=5           # consecutive failures before pausing a provider
# RP_BREAKER_COOLDOWN_MS=30000
# RP_JOB_LEASE_SECONDS=120
# RP_LOG_METRICS=1                 # 0 silences rp_metric log lines
