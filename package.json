{
  "name": "frontline-hiring-prototype",
  "version": "1.3.0",
  "private": true,
  "description": "Multi-Industry Frontline Hiring Platform \u2014 Pune BFSI prototype (PRD v1.3)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/migrate.ts && tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test": "tsx --env-file-if-exists=.env.local scripts/acceptance.ts"
  },
  "dependencies": {
    "next": "^15.5.25",
    "postgres": "3.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
