{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationCandidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "session_id": {
      "type": "string"
    },
    "transcript_hash": {
      "type": "string"
    },
    "rubric_version": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "status": {
            "enum": [
              "observed",
              "not_observed",
              "contradicted",
              "uncertain"
            ]
          },
          "learner_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "turn_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "turn_id",
                "start",
                "end",
                "quote"
              ]
            }
          },
          "context_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "turn_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "turn_id",
                "start",
                "end",
                "quote"
              ]
            }
          },
          "searched_turn_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 1000
          },
          "method": {
            "enum": [
              "rule",
              "semantic",
              "llm",
              "human"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rule_version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "category",
          "status",
          "learner_spans",
          "context_spans",
          "searched_turn_ids",
          "explanation",
          "method",
          "confidence"
        ]
      }
    },
    "dimension_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "score": {
            "type": "integer"
          },
          "anchor_score": {
            "type": "integer"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "enum": [
              "scored",
              "uncertain"
            ]
          }
        },
        "required": [
          "dimension_id",
          "score",
          "anchor_score",
          "evidence_ids",
          "rationale",
          "status"
        ]
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "uncertain"
            ]
          }
        },
        "required": [
          "rule_id",
          "evidence_ids",
          "status"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "session_id",
    "transcript_hash",
    "rubric_version",
    "evidence",
    "dimension_scores",
    "risk_flags"
  ]
}
