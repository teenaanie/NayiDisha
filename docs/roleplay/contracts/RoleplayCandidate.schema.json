{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoleplayCandidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "used_fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      }
    },
    "requested_end": {
      "type": "boolean"
    }
  },
  "required": [
    "text",
    "used_fact_ids",
    "requested_end"
  ]
}
