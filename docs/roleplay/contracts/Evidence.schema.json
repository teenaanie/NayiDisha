{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "status": {
      "enum": [
        "observed",
        "not_observed",
        "contradicted",
        "uncertain"
      ]
    },
    "learner_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "turn_id",
          "start",
          "end",
          "quote"
        ]
      }
    },
    "context_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "turn_id",
          "start",
          "end",
          "quote"
        ]
      }
    },
    "searched_turn_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 1000
    },
    "method": {
      "enum": [
        "rule",
        "semantic",
        "llm",
        "human"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rule_version": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "category",
    "status",
    "learner_spans",
    "context_spans",
    "searched_turn_ids",
    "explanation",
    "method",
    "confidence"
  ]
}
