{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScenarioBundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "difficulty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "learner_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "learner_brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "target_minutes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "uniqueItems": true
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "product",
        "skill",
        "difficulty",
        "locale",
        "learner_role",
        "learner_brief",
        "target_minutes",
        "objective_ids",
        "success_criteria"
      ]
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "initial_emotion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "speaking_style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "fact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "text",
              "fact_refs"
            ]
          }
        },
        "forbidden_inventions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "role",
        "relationships",
        "initial_emotion",
        "speaking_style",
        "concerns",
        "forbidden_inventions"
      ]
    },
    "facts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "type": {
            "enum": [
              "text",
              "money",
              "status",
              "relative_deadline"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "amount_minor": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amount_minor",
                  "currency"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "unit": {
                    "enum": [
                      "weeks",
                      "days"
                    ]
                  },
                  "relative_to": {
                    "const": "scenario_start"
                  }
                },
                "required": [
                  "amount",
                  "unit",
                  "relative_to"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "knowledge": {
            "enum": [
              "known",
              "unknown"
            ]
          },
          "visibility": {
            "enum": [
              "opening",
              "on_intent",
              "derived"
            ]
          },
          "release_intents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "uniqueItems": true
          },
          "prerequisite_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
            },
            "uniqueItems": true
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "value",
          "knowledge",
          "visibility",
          "release_intents",
          "prerequisite_fact_ids",
          "source_ref"
        ]
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opening_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "positive_examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "negative_examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            },
            "required": [
              "id",
              "description",
              "positive_examples",
              "negative_examples"
            ]
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "priority": {
                "type": "integer"
              },
              "intent_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "match": {
                "enum": [
                  "any",
                  "all"
                ]
              },
              "reveal_fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true
              },
              "response_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "concern_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              }
            },
            "required": [
              "id",
              "priority",
              "intent_ids",
              "match",
              "reveal_fact_ids"
            ]
          }
        },
        "unknown_response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "clarification_response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "multi_intent_mode": {
          "const": "answer_asked_only"
        },
        "off_topic_mode": {
          "const": "brief_redirect"
        },
        "injection_mode": {
          "const": "stay_in_character"
        },
        "max_new_facts_per_turn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "opening_text",
        "intents",
        "rules",
        "unknown_response",
        "clarification_response",
        "multi_intent_mode",
        "off_topic_mode",
        "injection_mode",
        "max_new_facts_per_turn"
      ]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "min_score": {
                "type": "integer",
                "minimum": 0
              },
              "max_score": {
                "type": "integer",
                "minimum": 1
              },
              "anchors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "score": {
                      "type": "integer"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "basis": {
                      "enum": [
                        "source",
                        "recommendation"
                      ]
                    }
                  },
                  "required": [
                    "score",
                    "description",
                    "basis"
                  ]
                }
              },
              "check_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true
              },
              "evaluation_method": {
                "enum": [
                  "rule",
                  "llm",
                  "hybrid"
                ]
              },
              "applicability": {
                "enum": [
                  "required",
                  "conditional"
                ]
              },
              "applicability_rule_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              }
            },
            "required": [
              "id",
              "name",
              "min_score",
              "max_score",
              "anchors",
              "check_ids",
              "evaluation_method",
              "applicability"
            ]
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "category": {
                "enum": [
                  "coverage",
                  "quality",
                  "compliance",
                  "conversation"
                ]
              },
              "method": {
                "enum": [
                  "rule",
                  "semantic",
                  "llm"
                ]
              },
              "accepted_intents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true
              },
              "credit_requires": {
                "enum": [
                  "learner_question",
                  "learner_action"
                ]
              },
              "expected_fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "description",
              "category",
              "method",
              "accepted_intents",
              "credit_requires",
              "expected_fact_ids"
            ]
          }
        },
        "evidence_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "version",
        "title",
        "dimensions",
        "checks",
        "evidence_categories"
      ]
    },
    "risk_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "category": {
                "enum": [
                  "selling",
                  "integrity",
                  "process"
                ]
              },
              "severity": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "detector": {
                "enum": [
                  "phrase_candidate",
                  "semantic",
                  "hybrid"
                ]
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "context_exclusions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "consequence": {
                "enum": [
                  "dimension_evidence",
                  "review"
                ]
              },
              "dimension_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "description",
              "category",
              "severity",
              "detector",
              "examples",
              "context_exclusions",
              "consequence",
              "dimension_ids"
            ]
          }
        }
      },
      "required": [
        "id",
        "version",
        "rules"
      ]
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "mode": {
          "enum": [
            "unweighted_sum",
            "weighted_percent"
          ]
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "upper_inclusive": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "lower",
              "upper",
              "upper_inclusive"
            ]
          }
        },
        "band_scale": {
          "enum": [
            "raw_sum",
            "percent"
          ]
        },
        "display_decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "risk_effect": {
          "enum": [
            "rubric_only",
            "cap",
            "deduction",
            "gate"
          ]
        },
        "risk_effect_parameters": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "version",
        "mode",
        "weights",
        "bands",
        "band_scale",
        "display_decimals",
        "risk_effect",
        "risk_effect_parameters"
      ]
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleplay": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "evaluator": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "coach": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "required": [
        "roleplay",
        "evaluator",
        "coach"
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_enabled": {
          "type": "boolean"
        },
        "focused_enabled": {
          "type": "boolean"
        },
        "focused_target_check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "uniqueItems": true
        },
        "focused_scoring": {
          "const": "checks_only"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "version_policy": {
          "const": "pin_parent"
        }
      },
      "required": [
        "full_enabled",
        "focused_enabled",
        "focused_target_check_ids",
        "focused_scoring",
        "instruction",
        "version_policy"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "basis": {
            "enum": [
              "source",
              "recommendation",
              "unspecified"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "path",
          "basis",
          "note"
        ]
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "scenario",
    "persona",
    "facts",
    "conversation",
    "rubric",
    "risk_policy",
    "scoring",
    "prompts",
    "retry",
    "provenance"
  ]
}
